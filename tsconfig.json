{
    "compilerOptions": {
        "allowJs": false,
        "forceConsistentCasingInFileNames": true,
        "lib": [
            "ESNext",
            "WebWorker"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noUncheckedIndexedAccess": true,
        "strict": true,
        "target": "ESNext",
        "useDefineForClassFields": true
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ]
}
